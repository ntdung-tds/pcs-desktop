{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pcs-2/schemas/tasks.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "kind",
      "owner",
      "status",
      "updated_at",
      "qa",
      "dependencies",
      "acceptance_criteria",
      "evidence",
      "acceptance",
      "current_step",
      "last_completed_step",
      "next_action",
      "blockers"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "code",
          "document",
          "research",
          "operations",
          "design"
        ]
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "enum": [
          "TODO",
          "READY",
          "IN_PROGRESS",
          "BLOCKED",
          "IN_REVIEW",
          "TECH_DONE",
          "ACCEPTED",
          "DEFERRED",
          "CANCELLED"
        ]
      },
      "updated_at": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      },
      "qa": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "NOT_RUN",
              "PASS",
              "FAIL",
              "BLOCKED",
              "NA"
            ]
          },
          "run_ref": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "source_sha": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "gate"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "gate": {
              "enum": [
                "soft",
                "start",
                "accept"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "feature_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "acceptance_criteria": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "kind",
            "ref",
            "observed_at",
            "verification"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "observed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "verification": {
              "type": "object",
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "DECLARED",
                    "VERIFIED",
                    "STALE"
                  ]
                },
                "method": {
                  "type": "string"
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                }
              }
            }
          }
        }
      },
      "acceptance": {
        "type": "object",
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "by": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "current_step": {
        "type": [
          "string",
          "null"
        ]
      },
      "last_completed_step": {
        "type": [
          "string",
          "null"
        ]
      },
      "next_action": {
        "type": "string",
        "minLength": 1
      },
      "blockers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "reason",
            "owner",
            "unblock_when"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "unblock_when": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "uniqueItems": false
}
